# Test output directories
#
# Currently, test builds are emitted into the "public" directory.
# Some users or environments may prefer using "dist" instead.
# Both directories contain generated artifacts and should not be
# tracked in version control.
test/public/
test/public_microfrontend/
test/dist/

# Demo output directories
demo/public/

# Build output directories
#
# Ignore every directory named "dist" anywhere in the repository.
**/dist/

# Agent model directories
#
# Local agent state and configuration — keep out of version control.
.kilo/
.kilocode/
.opencode/
