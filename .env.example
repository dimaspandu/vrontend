# Local configuration for the run.*.js scripts.
#
# Copy this file to .env and adjust as needed. The .env file is gitignored.
# Every key is optional; the values below are the defaults used when a key is
# missing or empty.

# Port for the dev server (run.dev.js) and the preview server (run.start.js).
PORT=7200

# Interface the servers bind to.
# Use 0.0.0.0 to expose the dev server on your local network.
HOST=localhost

# Minify the production build. Requires the `terser` CLI on PATH.
# With MINIFY=false the build stays offline and outputs unminified code.
MINIFY=true

# Name of the JSX factory the transpiler emits calls to.
# Must match the factory imported by your .jsx files.
JSX_FACTORY=elementBuilder

# Build output folder, relative to the repository root.
OUTPUT_DIR=dist